# Responsibility: Check configured IP and domain certificates for expiry and renew when required.
# Implementation: Certbot retains ACME validation and failure logs; Nginx is tested and reloaded after successful renewal.
# Relationships: salesmate-cert-renew.timer; port 80 must keep the ACME path reachable.
# Directory:
# - None
# Variable index:
# - ExecStart: Renewal command and successful-renewal deployment hook.
[Unit]
Description=Renew SalesMate IP and domain TLS certificates
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/certbot/bin/certbot renew --non-interactive --deploy-hook "/usr/sbin/nginx -t && /usr/bin/systemctl reload nginx"
