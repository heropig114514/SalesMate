# Responsibility: Run an isolated Celery consumer for the CRM or sales queue.
# Implementation: A prefork pool receives work through Redis; TERM reaches only the main process for graceful draining.
# Relationships: crm/sales schedulers stop and wait before consumers stop; no automatic restart of unknown external side effects.
# Directory:
# - None
# Variable index:
# - %i: Selects crm or sales.
# - CELERY_CONCURRENCY: Retains business concurrency limits of 3 and 1 respectively.
[Unit]
Description=SalesMate Celery %i
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=salesmate
Group=salesmate
WorkingDirectory=/opt/salesmate/app
EnvironmentFile=/opt/salesmate/shared/runtime.env
EnvironmentFile=/etc/salesmate/celery-%i.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.lightsail
Environment=PYTHONPATH=/opt/salesmate/app/backend:/opt/salesmate/app
ExecStart=/opt/salesmate/venv/bin/python -m celery -A config.celery:app worker --loglevel=WARNING --queues=%i --hostname=%i@%%h --concurrency=${CELERY_CONCURRENCY} --without-gossip --without-mingle
KillMode=mixed
TimeoutStopSec=infinity
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
