# Responsibility: Schedule twice-daily renewal checks for IP and domain certificates.
# Implementation: Run missed checks after machine recovery; Certbot separates checks from the actual renewal decision.
# Relationships: salesmate-cert-renew.service.
# Directory:
# - None
# Variable index:
# - OnCalendar: Daily check times.
# - Persistent: Enables catch-up checks after recovery.
[Unit]
Description=Schedule SalesMate certificate renewal checks

[Timer]
OnCalendar=*-*-* 00,12:00:00
Persistent=true

[Install]
WantedBy=timers.target
