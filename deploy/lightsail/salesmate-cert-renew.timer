# 职责：为 IP 和域名证书安排每日两次续期检查。
# 实现：机器离线后补执行错过的检查，检查与实际续期决策由 Certbot 分离。
# 关联：salesmate-cert-renew.service。
# 目录：无函数或类。
# 变量索引：OnCalendar 为每日检查时刻；Persistent 为恢复后补检查开关。
[Unit]
Description=Schedule SalesMate certificate renewal checks

[Timer]
OnCalendar=*-*-* 00,12:00:00
Persistent=true

[Install]
WantedBy=timers.target
