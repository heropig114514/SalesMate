# 职责：以普通服务用户运行 Django ASGI 网站。
# 实现：读取服务器专用环境文件，仅监听回环地址，由 Nginx 提供公网入口。
# 关联：依赖 PostgreSQL；日志进入 systemd journal；失败保留 failed 状态供检查。
# 目录：无函数或类。
# 变量索引：EnvironmentFile 为运行配置；ExecStart 为固定启动入口。
[Unit]
Description=SalesMate Django web
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=salesmate
Group=salesmate
WorkingDirectory=/opt/salesmate/app
EnvironmentFile=/opt/salesmate/app/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.lightsail
ExecStart=/opt/salesmate/venv/bin/python -m uvicorn --app-dir backend config.asgi:application --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
