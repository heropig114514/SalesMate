# Responsibility: Run the CRM scheduler shared by every active employee.
# Implementation: Retain project-default concurrency and polling, read connection configuration from the environment file, and create temporary employee credentials per work unit.
# Relationships: Celery consumers execute work while the scheduler command retains polling. It depends on the local website and database; business logs enter the journal and failed processes are not retried automatically.
# Directory:
# - None
# Variable index:
# - EnvironmentFile: Runtime configuration.
# - ExecStart: crm_worker entry point.
[Unit]
Description=SalesMate CRM worker
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=salesmate
Group=salesmate
WorkingDirectory=/opt/salesmate/app
EnvironmentFile=/opt/salesmate/shared/runtime.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.lightsail
ExecStart=/opt/salesmate/venv/bin/python backend/manage.py crm_worker
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
