# Responsibility: Run an independent-version Gunicorn/Uvicorn Web instance.
# Implementation: The port instance reads a fixed release and isolated virtual environment from slots; two processes host ASGI.
# Relationships: Blue-green release switches Nginx after health checking; every instance uses the same protected runtime configuration.
# Directory:
# - None
# Variable index:
# - %i: Port 8001 or 8002.
# - workers: Fixed at 2.
# - TimeoutStopSec: Lets requests finish naturally.
[Unit]
Description=SalesMate Web release on %i
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=salesmate
Group=salesmate
WorkingDirectory=/opt/salesmate/slots/%i/app
EnvironmentFile=/opt/salesmate/shared/runtime.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.lightsail
Environment=PYTHONPATH=/opt/salesmate/slots/%i/app
ExecStart=/opt/salesmate/slots/%i/venv/bin/gunicorn --chdir backend config.asgi:application --worker-class uvicorn_worker.UvicornWorker --bind 127.0.0.1:%i --workers 2 --access-logfile - --error-logfile - --forwarded-allow-ips=127.0.0.1 --graceful-timeout 120
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
TimeoutStopSec=150
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
