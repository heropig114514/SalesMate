# Copy to .env and replace both values. Never commit .env.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# PostgreSQL only. Create this database and role separately.
POSTGRES_DB=salesmate
POSTGRES_USER=salesmate
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=3

# Explicit placeholder mode. Set agent to leave jobs for an external Agent.
ANALYSIS_PROVIDER=rules

# Local settings only: skip the login screen for loopback browser requests.
# The user must already exist, be active, and have no admin privileges.
LOCAL_DEBUG_AUTO_LOGIN=True
LOCAL_DEBUG_USER=demo
