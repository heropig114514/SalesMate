# Responsibility: Continuously process general and customer chat requests for all active employees in serial order.
# Implementation: Use a dedicated chat_worker. It does not restart automatically after failure, and SIGTERM waits for the current task report.
# Relationships: Blue-green deployment starts chat after traffic cutover and drains it before replacement. It requires PostgreSQL; deployment scripts check HTTP readiness.
# Directory:
# - None
# Variable index:
# - EnvironmentFile: Supplies model and backend address from shared/runtime.env.
# - ExecStart: Consumer entry point.
# - User/Group: Existing service account.
# - TimeoutStopSec: Retains time for in-flight reports.
# - Restart: Prevents implicit recovery.
[Unit]
Description=SalesMate read-only sales chat worker
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=salesmate
Group=salesmate
WorkingDirectory=/opt/salesmate/app
EnvironmentFile=/opt/salesmate/shared/runtime.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.lightsail
ExecStart=/opt/salesmate/venv/bin/python backend/manage.py chat_worker
Restart=no
TimeoutStopSec=infinity
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
