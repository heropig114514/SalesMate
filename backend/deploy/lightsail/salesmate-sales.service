# Responsibility: Execute explicitly approved sales external actions and due in-product reminders.
# Implementation: Use the existing sales_worker default polling and atomic claim; it does not restart or resend automatically after failure.
# Relationships: Celery consumers execute work while the scheduler command retains polling. It shares the website's server database and credential key and is separate from the read-only mail-sync Worker.
# Directory:
# - None
# Variable index:
# - EnvironmentFile: Server runtime configuration.
# - ExecStart: Sales-task entry point.
# - User/Group: Restrict normal service identity.
# - UMask: Limits permissions of newly created files.
[Unit]
Description=SalesMate approved sales actions worker
After=network.target redis-server.service postgresql.service
Requires=redis-server.service postgresql.service

[Service]
Type=simple
User=salesmate
Group=salesmate
WorkingDirectory=/opt/salesmate/app
EnvironmentFile=/opt/salesmate/shared/runtime.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.lightsail
ExecStart=/opt/salesmate/venv/bin/python backend/manage.py sales_worker
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
