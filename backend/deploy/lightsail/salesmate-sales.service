# 职责：执行已明确批准的销售外部动作及到期站内提醒。
# 实现：使用既有 sales_worker 默认轮询与原子领取，失败不自动重启或重发。
# 关联：Celery 消费者执行工作，调度命令保留轮询；与网站使用同一服务器数据库及凭证密钥；独立于只读邮件同步 Worker。
# 目录：无函数或类。
# 变量索引：EnvironmentFile 为服务器运行配置；ExecStart 为销售任务入口；
# User/Group 限定普通服务身份；UMask 限制新建文件权限。
[Unit]
Description=SalesMate approved sales actions worker
After=network.target redis-server.service postgresql.service
Requires=redis-server.service postgresql.service

[Service]
Type=simple
User=salesmate
Group=salesmate
WorkingDirectory=/opt/salesmate/app
EnvironmentFile=/opt/salesmate/shared/runtime.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.lightsail
ExecStart=/opt/salesmate/venv/bin/python backend/manage.py sales_worker
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
