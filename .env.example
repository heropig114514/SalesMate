# SalesMate's single local configuration file. Copy it to the repository-root .env and fill in the values.

# Django
DJANGO_SECRET_KEY=replace-with-a-local-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
ANALYSIS_PROVIDER=rules
LOCAL_DEBUG_AUTO_LOGIN=True
LOCAL_DEBUG_USER=demo

# Explicit synthetic-fixture experiment mode; authentication, account ownership, versions, and confirmations remain mandatory.
# Keep False in production. Restart the Web, Agent, and background services after changing it.
LAB_OPEN_ACCESS=False

# Employee web Gmail authorization (the Google Cloud OAuth client type must be Web application).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/mailboxes/gmail-callback/

# Select a database explicitly. Local development uses PostgreSQL; replace account and password.
# To use SQLite intentionally, set DATABASE_URL=sqlite:///backend/db.sqlite3 explicitly.
DATABASE_URL=postgresql://salesmate:replace-me@127.0.0.1:5432/salesmate?connect_timeout=3

# Alibaba Bailian
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=
BAILIAN_ENABLE_THINKING=false

# Service configuration for Agent calls to Django.
SALESMATE_BACKEND_AGENT_URL=http://127.0.0.1:8000/api/v1/agent/
SALESMATE_AGENT_SERVICE_TOKEN=
SALESMATE_MAILBOX_ID=
SALESMATE_JOB_LEASE_SECONDS=120
SALESMATE_BACKEND_TIMEOUT=30

# Sales external actions: configure a Fernet credential-encryption key explicitly and retain it separately from database backups.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Also register the http://127.0.0.1:8000/api/v1/sales/oauth/ callback in Google Console.
SALESMATE_VAULT_KEY=

# QQ mailbox and SMTP are temporarily paused; retained history remains readable.
QQ_MAIL_ENABLED=false
