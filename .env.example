# SalesMate 唯一本地配置文件。复制为项目根目录 .env 后填写。

# Django
DJANGO_SECRET_KEY=replace-with-a-local-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
ANALYSIS_PROVIDER=rules
LOCAL_DEBUG_AUTO_LOGIN=True
LOCAL_DEBUG_USER=demo

# 显式实验开放模式：所有业务数据免登录、跨账号可读写；与 DEBUG 无关。
# 正式部署保持 False；切换后需重启 Web、Agent 和后台服务。
LAB_OPEN_ACCESS=False
LAB_DEFAULT_USER=algorithm-lab

# 员工网页 Gmail 授权（Google Cloud OAuth 客户端类型必须为 Web application）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/mailboxes/gmail-callback/

# 必须显式选择数据库；本项目本地开发使用 PostgreSQL。替换账号密码。
# 若有意使用 SQLite，可显式设置 DATABASE_URL=sqlite:///backend/db.sqlite3。
DATABASE_URL=postgresql://salesmate:replace-me@127.0.0.1:5432/salesmate?connect_timeout=3

# 阿里百炼
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=
BAILIAN_ENABLE_THINKING=false

# Agent 调用 Django 的服务配置
SALESMATE_BACKEND_AGENT_URL=http://127.0.0.1:8000/api/v1/agent/
SALESMATE_AGENT_SERVICE_TOKEN=
SALESMATE_MAILBOX_ID=
SALESMATE_JOB_LEASE_SECONDS=120
SALESMATE_BACKEND_TIMEOUT=30

# 销售外部动作：显式配置 Fernet 凭证加密密钥，并与数据库备份分开保管。
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Google 控制台另需登记 http://127.0.0.1:8000/api/v1/sales/oauth/ 回调。
SALESMATE_VAULT_KEY=

# QQ mailbox and SMTP are temporarily paused; retained history remains readable.
QQ_MAIL_ENABLED=false
